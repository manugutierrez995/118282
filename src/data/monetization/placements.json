{
  "version": 1,
  "enabled": true,
  "global": {
    "enabled": true,
    "headMarkup": ["exoclick_delegate_client_hints"],
    "fallback": { "enabled": true, "mode": "doku-doujins" },
    "fillDetection": {
      "timeoutMs": 10000,
      "claimedGracePeriodMs": 5000,
      "lateFillObservationMs": 10000,
      "minimumVisibleWidth": 40,
      "minimumVisibleHeight": 20,
      "minimumVisibleArea": 800,
      "requireRenderedCreativeForFilled": true,
      "providerMutationMeansClaimedOnly": true,
      "zeroSizeIframeMeansClaimedOnly": true,
      "zeroSizeProviderNodeMeansClaimedOnly": true,
      "filledStateIsTerminal": true,
      "fallbackOnlyWhenCompletelyEmpty": true
    }
  },
  "verification": {
    "enabled": true,
    "showPlacementLabels": false,
    "showProviderState": false,
    "showFallbackReason": false,
    "logToConsole": true,
    "exposeDebugAttributes": true
  },
  "placements": {
    "landing_top_leaderboard": { "enabled": true, "adId": "leaderboard_900x250", "location": "landing", "position": "top", "fallback": "doku-doujins" },
    "global_top_banner": { "enabled": true, "adId": "top_banner_728x90", "location": "global-header", "position": "below-header", "fallback": "doku-doujins" },
    "reader_between_pages": { "enabled": true, "adId": "banner_300x250", "location": "reader", "position": "between-pages", "frequency": { "mode": "fixed", "everyPages": 4, "minimumPages": 3, "maximumPages": 4 }, "adsPerBreak": { "mode": "fixed", "count": 1, "minimum": 1, "maximum": 3 }, "minimumPageBeforeFirstAd": 3, "maximumAdsPerChapter": 8, "trailingAd": false, "fallback": "doku-doujins" },
    "reader_video_slider": { "enabled": true, "adId": "video_slider", "location": "reader", "position": "provider-overlay", "fallback": "doku-doujins" },
    "desktop_full_page_interstitial": { "enabled": true, "adId": "desktop_interstitial", "location": "global", "position": "interstitial", "devices": ["desktop"], "frequency": { "maximumPerSession": 1 }, "fallback": "doku-doujins" },
    "mobile_full_page_interstitial": { "enabled": true, "adId": "mobile_interstitial", "location": "global", "position": "interstitial", "devices": ["mobile"], "frequency": { "maximumPerSession": 1 }, "fallback": "doku-doujins" },
    "global_popunder": { "enabled": true, "adId": "popunder", "location": "global", "position": "interaction-triggered", "frequency": { "maximumPerSession": 1 }, "fallback": "none" }
  }
